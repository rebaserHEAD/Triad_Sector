# Triad: the drydock's round-end sweep. The warning goes to the owner of every drydock hull still
# out when the round-end countdown starts; the reason is what the owner reads on the impound card.
drydock-sweep-warning = Your ship {$ship} is still out. If it is not stored when the round ends it will be impounded, and reclaiming it costs {$percent}% of its appraisal.
drydock-sweep-impound-reason = Still in the world at the end of round {$round}.
