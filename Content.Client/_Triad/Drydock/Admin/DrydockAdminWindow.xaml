<!-- Triad: the drydock admin panel, built to the "Drydock Surfaces" canvas (AdminEscrow /
     AdminSold artboards). One full-width bar across the top carries the search and the state
     chips; under it the hull list on the left and the selected hull on the right. There is no
     revisions panel: a revision is a timeline row, because the question an admin asks is always
     "what happened to this ship", never "list its documents".

     Rows, chips and state tags are built in code so their exact fill can change with selection
     and state; this file is the frame and the named holders. Tooltips live on this surface only,
     the player tab has none. -->
<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:ui="clr-namespace:Content.Client._NF.Shipyard.UI"
                      SetSize="1400 800"
                      MinSize="1100 640">
    <PanelContainer VerticalExpand="True" HorizontalExpand="True">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#1b1b1e"/>
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">

            <!-- ===================== Search and chips, one bar ===================== -->
            <PanelContainer HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#1b1b1e" BorderColor="#3a3a3e" BorderThickness="0 0 0 1"/>
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Horizontal" Margin="8 6" VerticalAlignment="Center">
                    <LineEdit Name="SearchInput"
                              MinWidth="360"
                              PlaceHolder="{Loc 'drydock-admin-search-placeholder'}"
                              ToolTip="{Loc 'drydock-admin-search-tooltip'}" />
                    <Button Name="SearchButton"
                            Text="{Loc 'drydock-admin-search-button'}"
                            StyleClasses="ButtonSquare"
                            MinWidth="70"
                            Margin="4 0 10 0" />
                    <BoxContainer Name="ChipRow" Orientation="Horizontal" VerticalAlignment="Center" />
                    <Control HorizontalExpand="True" />
                    <Label Name="CountLabel" Modulate="#8d8d8d" />
                </BoxContainer>
            </PanelContainer>

            <BoxContainer Orientation="Horizontal" VerticalExpand="True" HorizontalExpand="True" Margin="4">

                <!-- ===================== The hulls that matched ===================== -->
                <BoxContainer Orientation="Vertical" MinWidth="400" VerticalExpand="True">
                    <ScrollContainer Name="ShipScroll" VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                        <BoxContainer Name="ShipContainer" Orientation="Vertical" HorizontalExpand="True" />
                    </ScrollContainer>
                    <BoxContainer Orientation="Horizontal" Margin="2 4 2 0" VerticalAlignment="Center">
                        <Button Name="PrevPageButton" Text="{Loc 'drydock-admin-prev'}" StyleClasses="ButtonSquare" MinWidth="60" />
                        <Label Name="PageLabel" Margin="8 0" Modulate="#8d8d8d" HorizontalExpand="True" />
                        <Button Name="NextPageButton" Text="{Loc 'drydock-admin-next'}" StyleClasses="ButtonSquare" MinWidth="60" />
                    </BoxContainer>
                </BoxContainer>

                <!-- ===================== The selected hull ===================== -->
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="4 0 0 0">

                    <PanelContainer HorizontalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#1b1b1e" BorderColor="#3a3a3e" BorderThickness="1"/>
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" Margin="8">
                            <BoxContainer Name="HeaderRow" Orientation="Horizontal" VerticalAlignment="Center" />
                            <BoxContainer Orientation="Horizontal" Margin="0 6 0 0" VerticalAlignment="Center">
                                <BoxContainer Name="VerbRow" Orientation="Horizontal" VerticalAlignment="Center" />
                                <Control HorizontalExpand="True" />
                                <LineEdit Name="ReasonInput"
                                          MinWidth="300"
                                          PlaceHolder="{Loc 'drydock-admin-reason-placeholder'}"
                                          ToolTip="{Loc 'drydock-admin-reason-tooltip'}" />
                            </BoxContainer>
                        </BoxContainer>
                    </PanelContainer>

                    <!-- The standing offer. Only drawn while the hull is in escrow. -->
                    <PanelContainer Name="EscrowPanel" Visible="False" HorizontalExpand="True" Margin="0 4 0 0">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#26221a" BorderColor="#8a6a3a" BorderThickness="1"/>
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" Margin="8">
                            <RichTextLabel Name="EscrowBodyLabel" />
                            <RichTextLabel Name="EscrowLandsLabel" Margin="0 2 0 0" />
                        </BoxContainer>
                    </PanelContainer>

                    <BoxContainer Orientation="Horizontal" VerticalExpand="True" Margin="0 4 0 0">

                        <!-- Berths, then notes under them. -->
                        <PanelContainer MinWidth="420" VerticalExpand="True">
                            <PanelContainer.PanelOverride>
                                <gfx:StyleBoxFlat BackgroundColor="#1b1b1e" BorderColor="#3a3a3e" BorderThickness="1"/>
                            </PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="8" VerticalExpand="True">
                                <BoxContainer Orientation="Horizontal" VerticalAlignment="Center">
                                    <Label Name="BerthsTitle" StyleClasses="LabelHeading" HorizontalExpand="True" />
                                    <ui:DrydockMenuButton Name="GrantBerthButton"
                                                          Text="{Loc 'drydock-admin-grant-berth'}"
                                                          StyleClasses="ButtonSquare"
                                                          MinWidth="110"
                                                          AlignRight="True"
                                                          ToolTip="{Loc 'drydock-admin-grant-berth-tooltip'}" />
                                </BoxContainer>
                                <ScrollContainer Name="BerthScroll" HScrollEnabled="False" HorizontalExpand="True" Margin="0 6 0 0">
                                    <BoxContainer Name="BerthContainer" Orientation="Vertical" HorizontalExpand="True" />
                                </ScrollContainer>
                                <Label Text="{Loc 'drydock-admin-berths-hint'}" StyleClasses="LabelSubText" Margin="0 4 0 0" />
                                <Control VerticalExpand="True" />
                                <Label Text="{Loc 'drydock-admin-notes-title'}" StyleClasses="LabelHeading" Margin="0 6 0 3" />
                                <LineEdit Name="NotesInput" HorizontalExpand="True" PlaceHolder="{Loc 'drydock-admin-notes-placeholder'}" />
                            </BoxContainer>
                        </PanelContainer>

                        <!-- The hull's whole life. A revision is a row here, not a list of its own. -->
                        <PanelContainer HorizontalExpand="True" VerticalExpand="True" Margin="4 0 0 0">
                            <PanelContainer.PanelOverride>
                                <gfx:StyleBoxFlat BackgroundColor="#1b1b1e" BorderColor="#3a3a3e" BorderThickness="1"/>
                            </PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="8" VerticalExpand="True">
                                <Label Text="{Loc 'drydock-admin-timeline-title'}" StyleClasses="LabelHeading" />
                                <ScrollContainer Name="TimelineScroll" HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True" Margin="0 6 0 0">
                                    <BoxContainer Name="TimelineContainer" Orientation="Vertical" HorizontalExpand="True" />
                                </ScrollContainer>
                                <Label Text="{Loc 'drydock-admin-timeline-hint'}" StyleClasses="LabelSubText" Margin="0 4 0 0" />
                            </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>

                    <!-- What the last action did. The mockup has no such line, but every verb
                         returns a refusal string and swallowing it would hide the answer. -->
                    <Label Name="NoticeLabel" Visible="False" Margin="2 4 0 0" Modulate="#d9a441" />
                </BoxContainer>
            </BoxContainer>

            <!-- The shipyard console's own footer, because this is the same machine. -->
            <BoxContainer Orientation="Vertical" Margin="0 2 0 0">
                <PanelContainer StyleClasses="LowDivider" />
                <BoxContainer Orientation="Horizontal" Margin="10 5 5 4" VerticalAlignment="Bottom">
                    <Label Text="{Loc 'drydock-admin-flavor-left'}" StyleClasses="WindowFooterText" />
                    <Label Text="{Loc 'apc-menu-flavor-right'}" StyleClasses="WindowFooterText"
                           HorizontalAlignment="Right" HorizontalExpand="True" Margin="0 0 5 0" />
                    <TextureRect StyleClasses="NTLogoDark" Stretch="KeepAspectCentered"
                                 VerticalAlignment="Center" HorizontalAlignment="Right" SetSize="19 19"/>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:FancyWindow>
